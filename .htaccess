<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # If the requested file or directory exists, don't rewrite
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route /register to register.php
    RewriteRule ^register/?$ administrative/register.php [L,QSA]

    #####################################################################################
    # Administrative | Route /login to login.php
    RewriteRule ^login/?$ administrative/login.php [L,QSA]
    RewriteRule ^profile/?$ administrative/profile.php [L,QSA]
    RewriteRule ^upload/?$ administrative/developer.php [L,QSA]
    RewriteRule ^admin/model-pages/?$ administrative/model_pages.php [L,QSA]
    RewriteRule ^model/?$ overview.php [L,QSA] #ml_model.php redirect to overview.php
    RewriteRule ^logout/?$ administrative/logout.php [L,QSA]
    RewriteRule ^training/?$ training_ml/training.php [L,QSA] #upload training data, community

    # Unified model route handler (built-in files + editable overrides + shared custom section)
    RewriteRule ^model/(intothedeep|decode)/([a-zA-Z0-9_-]+)/?$ model_pages/router.php?season=$1&slug=$2 [L,QSA]

    
    #Setup
    RewriteRule ^model/overview?$ setup/overview.php [L,QSA]
    RewriteRule ^model/intothedeep/overview?$ setup/overview.php [L,QSA]
    RewriteRule ^model/decode/overview?$ ftc_decode/setup/overview.php [L,QSA]
    RewriteRule ^model/intothedeep/prerequisites?$ setup/prerequisites.php [L,QSA]
    RewriteRule ^model/decode/prerequisites?$ ftc_decode/setup/prerequisites.php [L,QSA]
    RewriteRule ^model/intothedeep/resources?$ setup/resources.php [L,QSA]
    RewriteRule ^model/decode/resources?$ ftc_decode/setup/resources.php [L,QSA]
    
    #2D Sample Detection
    RewriteRule ^model/intothedeep/2d_cameracalib?$ 2d_sample_detection/cameracalib.php [L,QSA]
    RewriteRule ^model/decode/2d_cameracalib?$ ftc_decode/2d_sample_detection/cameracalib.php [L,QSA]
    
    #3D Sample Detection
    RewriteRule ^model/intothedeep/3d_cameracalib?$ 3d_sample_detection/cameracalib.php [L,QSA]
    RewriteRule ^model/decode/3d_cameracalib?$ ftc_decode/3d_sample_detection/cameracalib.php [L,QSA]

    #Training ML
    RewriteRule ^model/intothedeep/training?$ training_ml/traningdata.php [L,QSA]
    RewriteRule ^model/decode/training?$ training_ml/traningdata.php [L,QSA]
    RewriteRule ^model/intothedeep/training_structure?$ training_ml/trainings.php [L,QSA]
    RewriteRule ^model/decode/training_structure?$ training_ml/trainings.php [L,QSA]
    RewriteRule ^model/intothedeep/training_ml?$ training_ml/pythontraining.php [L,QSA]
    RewriteRule ^model/decode/training_ml?$ training_ml/pythontraining.php [L,QSA]
    RewriteRule ^model/intothedeep/online_training_ml?$ training_ml/online_training_ml.php [L,QSA]
    RewriteRule ^model/decode/online_training_ml?$ training_ml/online_training_ml.php [L,QSA]
    RewriteRule ^model/intothedeep/label_tool?$ training_ml/label_tool.php [L,QSA]
    RewriteRule ^model/decode/label_tool?$ training_ml/label_tool.php [L,QSA]

    #Examples
    RewriteRule ^model/intothedeep/pythonml?$ examples/pythonml.php [L,QSA]
    RewriteRule ^model/decode/pythonml?$ ftc_decode/examples/pythonml.php [L,QSA]
    RewriteRule ^model/intothedeep/android_studio?$ examples/android_studio.php [L,QSA]
    RewriteRule ^model/decode/android_studio?$ ftc_decode/examples/android_studio.php [L,QSA]
    RewriteRule ^model/intothedeep/robot_control?$ examples/robot_control.php [L,QSA]
    RewriteRule ^model/decode/robot_control?$ ftc_decode/examples/robot_control.php [L,QSA]

    #######################################################################################    

    #FTC DECODE 2026

    RewriteRule ^model/decode/apriltag/?$ ftc_decode/apriltag/getting_started.php [L,QSA]
    RewriteRule ^model/decode/apriltag_code_sample/?$ ftc_decode/apriltag/apriltag_code_sample.php [L,QSA]
    RewriteRule ^model/decode/apriltag_implementation/?$ ftc_decode/apriltag/apriltag_code_sample.php [L,QSA]

    #Autonomous Control
    RewriteRule ^model/decode/autonomous/?$ ftc_decode/auto_control/getting_started.php [L,QSA]
    RewriteRule ^model/decode/odometry/?$ ftc_decode/auto_control/odometry_pods.php [L,QSA]
    RewriteRule ^model/decode/road_runner_056/?$ ftc_decode/auto_control/rr_05.php [L,QSA]
    RewriteRule ^model/decode/road_runner_10/?$ ftc_decode/auto_control/rr_10.php [L,QSA]
    RewriteRule ^model/decode/pedro_pathing/?$ ftc_decode/auto_control/pedro_pathing.php [L,QSA]

    #Auto Aiming
    RewriteRule ^model/decode/auto_aiming_getting_started/?$ ftc_decode/auto_aim/getting_started.php [L,QSA]
    RewriteRule ^model/decode/gyroscope_only/?$ ftc_decode/auto_aim/gyroscope_only.php [L,QSA]
    RewriteRule ^model/decode/camera_only/?$ ftc_decode/auto_aim/webcam_only.php [L,QSA]
    RewriteRule ^model/decode/gyroscope_and_camera/?$ ftc_decode/auto_aim/gyroscope_and_webcam.php [L,QSA]

    # Optionally, route the root URL to index.php
    RewriteRule ^$ index.php [L,QSA]
</IfModule>
